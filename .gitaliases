[alias]
# log
llh = log-list -n 5
llr = log-list --date=relative
lln = log-list --numstat

pick = "!f() { fzf --preview=\"$1\" --preview-window='~3' --multi --reverse --border; }; f"
af = "!git add $(git ls-files --modified --others --exclude-standard | git pick 'git diff {} | delta')"
uf = "!git restore --staged $(git diff --cached --name-only | git pick 'git diff --staged {} | delta')"
bf = "!git switch $(git branch --format='%(refname:short)' | git pick 'git log --oneline -20 {}')"
df = "!f() { git diff --name-only ${1:-HEAD} | git pick \"git diff ${1:-HEAD} -- {} | delta\"; }; f"
rf = "!git restore $(git diff --name-only | git pick 'git diff {} | delta')"
cf = "!git ls-files --others --exclude-standard | git pick 'git diff --no-index /dev/null {} | delta' | xargs -r git clean -f --"

# mirror
sync = "!git add -A && git commit -m \"sync\" && git push"
resync = "!git add -A && git commit --amend --no-edit && git push --force-with-lease"

# amend, preserve timestamps
recommit = "!f() { GIT_COMMITTER_DATE=\"$(git log -1 --format=%aD)\" git commit --amend --no-edit --date=\"$(git log -1 --format=%aD)\" \"$@\"; }; f"
reword = "!f() { GIT_COMMITTER_DATE=\"$(git log -1 --format=%aD)\" git commit --amend --date=\"$(git log -1 --format=%aD)\" \"$@\"; }; f"
redate = "!f() { GIT_COMMITTER_DATE=\"$1\" git commit --amend --no-edit --date=\"$1\"; }; f"
